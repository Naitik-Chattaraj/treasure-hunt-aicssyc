# ==============================================================================
# AICSSYC TREASURE HUNT - ENVIRONMENT CONFIGURATION (DUAL-DATABASE SETUP)
# ==============================================================================

# ------------------------------------------------------------------------------
# ROUTE 1 DATABASE (Primary / Current Supabase Project)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-route1-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-route1-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-route1-service-role-key

# Optional explicit aliases:
# SUPABASE_ROUTE_1_URL=https://your-route1-project.supabase.co
# SUPABASE_ROUTE_1_ANON_KEY=eyJhbGciOi...
# SUPABASE_ROUTE_1_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# ROUTE 2 DATABASE (Secondary / Dedicated Supabase Project for Route 2)
# ------------------------------------------------------------------------------
SUPABASE_ROUTE_2_URL=https://your-route2-project.supabase.co
SUPABASE_ROUTE_2_ANON_KEY=eyJhbGciOi...your-route2-anon-key
SUPABASE_ROUTE_2_SERVICE_ROLE_KEY=eyJhbGciOi...your-route2-service-role-key

# Admin Authentication & Security
ADMIN_PASSWORD_HASH=$2a$10$YourGeneratedBcryptHashHere
# Random 32+ character string for signing admin JWT sessions
ADMIN_JWT_SECRET=your-random-32-character-secret-string-here
