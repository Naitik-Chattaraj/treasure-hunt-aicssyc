# ==============================================================================
# AICSSYC TREASURE HUNT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Credentials (from Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Admin Authentication & Security
ADMIN_PASSWORD_HASH=$2a$10$YourGeneratedBcryptHashHere
# Random 32+ character string for signing admin JWT sessions
ADMIN_JWT_SECRET=your-random-32-character-secret-string-here

# Flag to switch between local mock data and real Supabase backend
NEXT_PUBLIC_USE_MOCK=false
